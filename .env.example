# AI BEDAH CHART - Environment Variables
# Copy file ini jadi .env dan isi token kamu:
#   cp .env.example .env
#   nano .env

# Telegram Bot Token (dari @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# TwelveData API Key (https://twelvedata.com/)
# Free tier: 8 API credits/menit, 800/hari
TWELVEDATA_API_KEY=your_twelvedata_api_key_here

# Finnhub API Key (https://finnhub.io/) - untuk DXY, US10Y, VIX, news
# Free tier: 60 API/menit. Optional - kalau kosong, /signal pakai proxy.
FINNHUB_API_KEY=your_finnhub_api_key_here

# Optional: Port untuk health server (default 8080)
# PORT=8080
